NODE_ENV=development
PORT=4000

# Host port 5433 maps to the Postgres container in docker-compose.yml
DATABASE_URL=postgresql://thrift:thrift@localhost:5433/thriftvault

# Optional. Without it the rate limiter falls back to an in-process counter.
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret

ORDER_HOLD_MINUTES=15
UPLOAD_DIR=uploads

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
