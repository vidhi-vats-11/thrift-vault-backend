# Thrift Vault API — environment.
#
# Every var the backend reads lives in src/config/env.js (plus the two DB URLs
# read by prisma/schema.prisma). Marked [REQUIRED] / [OPTIONAL] below:
#   [REQUIRED] -> the process throws on boot (or migrations fail) without it
#   [OPTIONAL] -> has a working default, shown in the comment
#
# On Fly these are set with `fly secrets set KEY=value` (secrets are also
# injected into the release_command machine, which is what runs migrations).
# NODE_ENV / PORT / UPLOAD_DIR are already set in fly.toml [env].

# [OPTIONAL] default: development. fly.toml sets this to production.
NODE_ENV=development
# [OPTIONAL] default: 4000. Must match fly.toml internal_port.
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# [REQUIRED] Runtime connection. On Neon this is the -pooler host.
# Host port 5433 maps to the Postgres container in docker-compose.yml.
DATABASE_URL=postgresql://thrift:thrift@localhost:5433/thriftvault

# [REQUIRED] Direct (non-pooled) connection. schema.prisma declares this as
# `directUrl`, and `prisma migrate deploy` cannot run over a transaction
# pooler. On Neon it is the host without `-pooler`; on Fly Postgres (no pooler)
# and locally it is simply the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://thrift:thrift@localhost:5433/thriftvault

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# [REQUIRED] Generate per-environment values, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev_access_secret_change_me
# [REQUIRED]
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
# [OPTIONAL] default: 15m
JWT_ACCESS_TTL=15m
# [OPTIONAL] default: 30
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# [OPTIONAL] default: http://localhost:5173 — but in production that default
# blocks the real site, so treat it as required on Fly. Comma-separated,
# scheme + host, no trailing slash. Must list the deployed frontend origin:
#   CORS_ORIGINS=https://thriftvaultstore.vercel.app
# Add preview/staging origins to the same comma-separated list as needed.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# [OPTIONAL] default: mock (the only gateway registered in payment/gateway.js)
PAYMENT_GATEWAY=mock
# [OPTIONAL] default: dev_webhook_secret — the app boots without it, but that
# default is public knowledge, so set a real value in production.
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret
# [OPTIONAL] default: 15 (minutes a checkout holds stock)
ORDER_HOLD_MINUTES=15

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# [OPTIONAL] default: uploads. Only used when BLOB_READ_WRITE_TOKEN is empty.
UPLOAD_DIR=uploads

# [OPTIONAL] to boot, but REQUIRED in production. Its presence is what switches
# lib/storage.js from local disk to Vercel Blob. Fly machine disks are wiped on
# every deploy, so without this token every uploaded product image is lost on
# the next deploy while ProductImage.url still points at /uploads/<id>.
# The token works from anywhere — it does not require running on Vercel.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Optional infrastructure
# ---------------------------------------------------------------------------
# [OPTIONAL] Without it the rate limiter falls back to an in-process counter,
# which is correct for a single machine but not across Fly replicas.
REDIS_URL=redis://localhost:6380

# [OPTIONAL] Bearer token required by POST/GET /api/v1/internal/sweep. Leave
# blank and the endpoint 404s, which is the safe default: server.js already
# runs the sweep on a 60s in-process timer. Set it only if you want an external
# scheduler (or a human) to be able to force a sweep.
CRON_SECRET=
