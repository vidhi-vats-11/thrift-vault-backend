NODE_ENV=development
PORT=4000

# Host port 5433 maps to the Postgres container in docker-compose.yml
DATABASE_URL=postgresql://thrift:thrift@localhost:5433/thriftvault

# Optional. Without it the rate limiter falls back to an in-process counter.
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret

ORDER_HOLD_MINUTES=15

# Local disk target for product images. Ignored when BLOB_READ_WRITE_TOKEN is set.
UPLOAD_DIR=uploads

# Set automatically by the Vercel Blob integration in deployed environments.
# Leave blank locally to keep writing images to UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=

# Bearer token Vercel Cron must present to run the order sweep. Leave blank
# locally: the endpoint 404s without it, and server.js sweeps on a timer anyway.
CRON_SECRET=

# Comma-separated. In production this must list the deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Direct (non-pooled) connection used by prisma migrate. On Neon this is the
# -pooler-less host; locally it is the same database as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://thrift:thrift@localhost:5433/thriftvault
